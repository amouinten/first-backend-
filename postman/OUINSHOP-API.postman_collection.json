    {
      "name": "5. Rate limiting",
      "item": [
        {
          "name": "Login rate limit: send 6 times or more (expect 429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 until the limit, then 429', () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Limit: 5 login requests per 15 minutes per IP. Run this request repeatedly (Collection Runner, 7 iterations). The first requests return 401, then 429."
          }
        },
        {
          "name": "General rate limit: GET /api/products (100 per 15 minutes)",
