        {
          "name": "Register a new user (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'student' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Password hash is never returned', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
