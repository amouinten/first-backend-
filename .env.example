PORT=3000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=1h

# Origins allowed to call the API from a browser (comma separated). 5173 is the Vite dev server of the React app.
CORS_ORIGINS=http://localhost:5173

# OAuth 2.0 / OpenID Connect: the API validates provider access tokens by calling this userinfo endpoint.
# Default is Google. Leave empty to disable OAuth 2.0 and accept only the API's own JWTs.
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Optional: only these provider accounts may use OAuth 2.0 tokens (comma separated emails). Empty = any valid account.
OAUTH_ALLOWED_EMAILS=

# Rate limiting (window in minutes)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
